From 6f8c66898903d5d5c7b16c8704aa328282ddde2d Mon Sep 17 00:00:00 2001
From: aobaharuki2005 <tranbaohnth@outlook.com>
Date: Thu, 28 May 2026 05:24:40 +0700
Subject: [PATCH 13/13] Fix: use newly build LLVM 19

---
 .github/workflows/build.yml | 8 ++++----
 config-legacy.toml          | 8 ++++----
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 42bfa43da68..e4aa23b22ae 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -17,15 +17,15 @@ jobs:
       - name: Select Xcode 16.0
         run: sudo xcode-select -s /Applications/Xcode_16.app/Contents/Developer
 
-      - name: Restore cached LLVM 18 (Rust 1.78-1.81)
+      - name: Restore cached LLVM 19 (Rust 1.82-1.86)
         id: cache-llvm-restore
         uses: actions/cache/restore@27d5ce7f107fe9357f9df03efb73ab90386fccae  # v5.0.5
         with:
-          key: ${{ runner.os }}-llvm18-${{ github.run_id }}
+          key: ${{ runner.os }}-llvm19-${{ github.run_id }}
           path: |
             build/aarch64-apple-darwin/llvm
           restore-keys:
-            ${{ runner.os }}-llvm18
+            ${{ runner.os }}-llvm19
 
       - name: Manually bootstrapping custom Rust
         run: |
@@ -43,7 +43,7 @@ jobs:
         if: steps.cache-llvm-restore.outputs.cache-matched-key == ''
         uses: actions/cache/save@27d5ce7f107fe9357f9df03efb73ab90386fccae # v5.0.5
         with:
-          key: ${{ runner.os }}-llvm18-${{ github.run_id }}
+          key: ${{ runner.os }}-llvm19-${{ github.run_id }}
           path: |
             build/aarch64-apple-darwin/llvm
 
diff --git a/config-legacy.toml b/config-legacy.toml
index 2f593880b74..e0143555fb3 100644
--- a/config-legacy.toml
+++ b/config-legacy.toml
@@ -14,11 +14,11 @@ submodules = false
 tools = [ "cargo" ]
 cargo-native-static = true
 
-[target.aarch64-apple-darwin]
-llvm-config = "build/aarch64-apple-darwin/llvm/bin/llvm-config"
+# [target.aarch64-apple-darwin]
+# llvm-config = "build/aarch64-apple-darwin/llvm/bin/llvm-config"
 
-[target.x86_64-apple-darwin]
-llvm-config = "build/aarch64-apple-darwin/llvm/bin/llvm-config"
+# [target.x86_64-apple-darwin]
+# llvm-config = "build/aarch64-apple-darwin/llvm/bin/llvm-config"
 
 [llvm]
 download-ci-llvm = false
-- 
2.50.1 (Apple Git-155)

